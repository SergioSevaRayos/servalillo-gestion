# .env de PRODUCCIÓN — copia a .env en el VPS y rellena lo marcado con «???».
# Después de editar: php artisan config:cache

APP_NAME="Gestión Servalillo"
APP_ENV=production
APP_KEY=                              # php artisan key:generate
APP_DEBUG=false
# Con dominio + TLS: https://tudominio.com
# Arranque provisional por IP sin TLS: http://LA_IP  (y SESSION_SECURE_COOKIE=false, ver abajo)
APP_URL=https://???.tudominio.com
APP_TIMEZONE=Europe/Madrid

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Base de datos (PostgreSQL local del VPS) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=servalillo
DB_USERNAME=servalillo
DB_PASSWORD=???                       # createuser con una contraseña fuerte

# --- Sesión / seguridad ---
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
# true SOLO con HTTPS: sobre http el navegador no devuelve la cookie y el login
# da "page expired" (419). Ponlo a false mientras arranques por IP sin TLS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Cola / caché / broadcast (todo en Postgres; sin Redis, sin Reverb) ---
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log

# --- Correo (los albaranes por email lo necesitan) ---
# SMTP real: el del hosting del dominio, o Brevo / Amazon SES (free tier).
# Puerto 587 + STARTTLS (scheme "smtp"): Hetzner bloquea saliente los puertos 25 y 465 por
# defecto en VPS nuevos (anti-spam) — 465/"smtps" (TLS implícito) da timeout.
MAIL_MAILER=smtp
MAIL_HOST=???
MAIL_PORT=587
MAIL_USERNAME=???
MAIL_PASSWORD=???
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="albaranes@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Almacenamiento: Cloudflare R2 (PDFs de albarán + firmas) ---
# Deja las R2_* en blanco (NO "???") mientras no tengas el bucket: config/filesystems.php
# decide si usar S3 con `env('R2_ACCESS_KEY_ID') ? ... : local`, y "???" es una cadena no
# vacía → truthy → intenta cargar el driver S3 (no instalado) y rompe cualquier guardado de
# PDF/firma. Vacío cae automáticamente a disco local (storage/app/private/r2), que funciona.
FILESYSTEM_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=servalillo
R2_ENDPOINT=
R2_URL=

# --- APK tracker (Bloque 10) ---
DEVICE_ENROLMENT_SECRET=???           # secreto fuerte; el mismo va en dart_define.production.json

# --- Ventana de tracking GPS y retención ---
TRACKING_PAUSE_START=22:00
TRACKING_PAUSE_END=05:00
GPS_PING_INTERVAL=45
GPS_PING_DISTANCE=75
GPS_RETENTION_DAYS=90

# --- Ruta eficiente (OSRM público con fallback local) ---
ROUTING_OSRM_ENABLED=true
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT=4
OSRM_CONNECT_TIMEOUT=2

# --- Base de la flota (la nave real) ---
BASE_LATITUDE=36.876880
BASE_LONGITUDE=-2.443087

# --- Depósitos SGRA (proyecto externo, panel /depositos) ---
# base_url por Tailscale: el VPS debe estar unido al mismo tailnet que el NAS
# (ver CLAUDE.md, "Depósitos SGRA"). SGRA_DASH_PASSWORD tiene que ser la contraseña
# REAL del dashboard SGRA (no el placeholder "admin" con el que arranca por defecto).
SGRA_ENABLED=false
SGRA_BASE_URL=http://100.97.218.44:8090
SGRA_PUBLIC_URL=http://sgra-aljibe.duckdns.org:8090
SGRA_DASH_USER=???
SGRA_DASH_PASSWORD=???
SGRA_TIMEOUT=5
SGRA_CONNECT_TIMEOUT=3
SGRA_CACHE_SECONDS=30

BCRYPT_ROUNDS=12
