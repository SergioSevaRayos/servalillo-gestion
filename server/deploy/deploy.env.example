# Config de despliegue. Copia a deploy.env (gitignored) y rellena.

# Usuario y host del VPS (el que tiene la clave SSH y sudo sin contraseña para reload de php-fpm).
VPS=deploy@TU_IP_O_HOST

# Carpeta del repo clonado en el VPS.
APP_DIR=/var/www/servalillo

# Dominio en producción (para el smoke check final).
DOMAIN=servalillo.example.com
