<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Release (produccion): SOLO HTTPS. El servidor va tras nginx + Let's Encrypt.
      Debug (pruebas en LAN): se permite HTTP en claro para apuntar a http://IP-DEL-PC:8000
      desde el movil. "debug-overrides" solo aplica cuando android:debuggable es true, o sea
      en las builds debug ("flutter build apk debug" / "flutter run"). Ver mobile/README.md.
    -->
    <base-config cleartextTrafficPermitted="false" />
    <debug-overrides>
        <base-config cleartextTrafficPermitted="true" />
    </debug-overrides>
</network-security-config>
